# Toutes les variables du frontend sont publiques par construction (préfixe NEXT_PUBLIC_).
# Aucune clé secrète Supabase service_role, R2, Google ou VPS ne doit apparaître ici.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique Supabase : `sb_publishable_*` (nouvelle forme) ou clé anon classique.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre-clee-publique
# NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clee-anon-publique
NEXT_PUBLIC_WORKER_API_URL=https://api.votre-domaine.example
