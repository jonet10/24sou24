# Valeurs fictives uniquement. En production : `wrangler secret put <NOM>`.
SUPABASE_URL=https://votre-projet.supabase.co
# Une seule clé publique suffit : `sb_publishable_*` (nouvelle forme) ou clé anon classique.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_votre-clee-publique
# SUPABASE_ANON_KEY=votre-cle-anon-publique
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete
SECRETS_ENCRYPTION_KEY=cle-aes-gcm-de-32-octets-en-base64
MEDIA_SIGNING_KEY=cle-hmac-pour-les-urls-de-lecture-temporaires
VPS_SYNC_SECRET=secret-partage-worker-vps
GOOGLE_CLIENT_ID=votre-client-id-google.apps.googleusercontent.com
