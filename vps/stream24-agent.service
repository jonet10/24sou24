[Unit]
Description=STREAM24 VPS agent (synchronisation Worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stream24
Group=stream24
EnvironmentFile=/etc/stream24/agent.env
ExecStart=/usr/bin/python3 /opt/stream24/stream24_agent.py
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
WorkingDirectory=/var/lib/stream24
NoNewPrivileges=true
PrivateTmp=true
ProtectProc=invisible
RestrictSUIDSGID=true
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/stream24 /var/lib/stream24
CPUQuota=20%
MemoryMax=256M

[Install]
WantedBy=multi-user.target
